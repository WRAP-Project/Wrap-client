# 이 파일을 .env.local로 복사해서 쓰세요. (.env.local은 *.local 규칙으로 git에 올라가지 않습니다)

# 백엔드 API 베이스 URL.
# 미설정 시 배포 서버(https://wrap-backend-ko54.onrender.com)를 씁니다.
# 백엔드를 로컬로 띄웠다면 http://localhost:8080으로 바꾸세요.
VITE_API_BASE_URL=https://wrap-backend-ko54.onrender.com

# 로그인 가드. "true"일 때만 켜집니다.
# 아직 mock으로 동작하는 화면이 많아, 그 화면들을 로그인 없이 보려면 false로 둡니다.
VITE_AUTH_REQUIRED=false

# ── 인증 관련 주의사항 ────────────────────────────────────────────────────────
# 1. 세션 쿠키(JSESSIONID) 방식입니다. 토큰이 아니라 쿠키로 인증합니다.
# 2. 백엔드 CORS 허용 origin이 배열이 아니라 단일 값입니다. 로컬 프론트는
#    http://localhost:5173 고정이어야 하고, 그래서 vite.config.ts에 strictPort를
#    켜뒀습니다. 포트가 바뀌면 CORS가 막힙니다.
# 3. 배포 환경에서는 세션 쿠키가 Secure; SameSite=None이라 프론트도 HTTPS여야 하며,
#    Render의 FRONTEND_ORIGIN 값과 프론트 배포 주소가 스킴·포트까지 정확히
#    같아야 합니다.
# 4. 세션은 30분 뒤 만료됩니다. 그 다음 요청의 401은 클라이언트가 가로채서
#    로그인 화면으로 보냅니다(src/lib/api/client.ts).
